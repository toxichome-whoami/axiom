# ─────────────────────────────────────────────────────────────────────────────
# Axiom Benchmark Configuration
# ─────────────────────────────────────────────────────────────────────────────
# Usage with inline CLI args (overrides .env):
#   go run bench_db.go <BEARER_TOKEN> [concurrency] [total_requests]
# ─────────────────────────────────────────────────────────────────────────────

# Base URL of the running Axiom server
API_URL=http://127.0.0.1:4500

# API Key – Base64-encoded "name:secret" from config.toml
API_KEY=YOUR_BASE64_ENCODED_KEY_HERE

# Target database name (as defined in config.toml [database.*])
DB_NAME=localdb_1

# Benchmark load parameters
CONCURRENCY=50
TOTAL_REQUESTS=500
