# Example .env for Axiom API Tests
# Copy this file to .env and replace the values with your actual configuration
#
# The base URL of the Axiom server
AXIOM_URL=http://localhost:4500

# The admin static API key from config.toml
AXIOM_TOKEN=your_admin_token_here

# Target database alias to run tests against
DB_NAME=localdb

# Target database table to fetch rows from during tests
DB_TABLE=demo_graphql_users

# Target storage alias to run file system tests against
STORAGE_NAME=local_uploads
