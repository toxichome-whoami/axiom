# DO NOT REMOVE OR MODIFY. CLOUDLINUX ENV VARS CONFIGURATION BEGIN
<IfModule Litespeed>
</IfModule>
# DO NOT REMOVE OR MODIFY. CLOUDLINUX ENV VARS CONFIGURATION END

RewriteEngine On

# Force HTTPS
RewriteCond %{HTTPS} !=on
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# Reverse Proxy - Send gRPC traffic to port 4501
RewriteCond %{HTTP:Content-Type} ^application/grpc [NC]
RewriteRule ^(.*)$ http://127.0.0.1:4501/$1 [P,L]

# NOTE: The port below (4500) is updated automatically by axiom.sh during
# zero-downtime updates. It alternates between 4500 and 4501.
# DO NOT hardcode — run ./axiom.sh update <version> instead.

# Reverse Proxy - Send all other traffic to Axiom on port 4500
RewriteRule ^(.*)$ http://127.0.0.1:4500/$1 [P,L]

# Proxy headers to forward real visitor IP to the app
<IfModule mod_headers.c>
    RequestHeader set X-Forwarded-Proto "https"
    RequestHeader set X-Forwarded-Port "443"
    RequestHeader set X-Forwarded-For "%{REMOTE_ADDR}e"
</IfModule>
