# ─────────────────────────────────────────────────────────────────────────────
# Axiom API Gateway - Apache Reverse Proxy Configuration
# ─────────────────────────────────────────────────────────────────────────────

# Disable directory browsing for security
Options -Indexes

# Hide Apache server signature
ServerSignature Off

# ─── CRITICAL SECURITY: Block Sensitive Files ──────────────────────────────
# If the Rust backend goes offline, Apache might try to serve files statically.
# This prevents anyone from downloading your config, database, or binary files.
<FilesMatch "(?i)\.(toml|db|sqlite|sqlite3|exe|log|env|sh|ps1|go|rs|md|lock|bak|swp|pid)$">
    Require all denied
</FilesMatch>

# Block access to all hidden files (like .env, .git)
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Block direct access to internal folders (fail-closed 403)
RedirectMatch 403 ^/(src|data|logs|tools|scripts|docs|crates|target|ui|tests|benches)/
# ─────────────────────────────────────────────────────────────────────────────

<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Force HTTPS (Crucial for API Key security)
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # 2. Proxy all traffic to the Axiom Rust Backend (Port 4500)
    RewriteRule ^(.*)$ http://127.0.0.1:4500/$1 [P,L]
</IfModule>

# 3. Security & Proxy Headers
<IfModule mod_headers.c>
    # Forward client HTTPS status to Axiom
    RequestHeader set X-Forwarded-Proto "https"
    RequestHeader set X-Forwarded-Port "443"
    
    # Hardened Security Headers (Double-layer protection before it hits Rust)
    # NOTE: HSTS only meaningful over HTTPS (enforced above); deprecated
    # X-XSS-Protection removed (can introduce old-IE XSS sink).
    Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" env=HTTPS
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "no-referrer"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    
    # Hide the fact that Apache is running
    Header unset Server
    Header unset X-Powered-By
</IfModule>
